#!/bin/sh

#
# Official-style Gradle start script (POSIX). Regenerated for Linux/Docker builds.
#
APP_HOME=$(cd "$(dirname "$0")" && pwd -P) || exit
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
  JAVACMD=$JAVA_HOME/bin/java
else
  JAVACMD=java
fi

# Word-split DEFAULT_JVM_OPTS carefully — do not nest quotes inside the value
exec "$JAVACMD" -Xmx64m -Xms64m \
  -Dorg.gradle.appname=gradlew \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
